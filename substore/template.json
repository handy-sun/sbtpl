{
  "log": {
    "level": "info",
    "output": "box.log",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "[::]:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://codeberg.org/handy/proxyconfig/releases/download/v0.2.0/dist.zip",
      "external_ui_download_detour": "🎯Direct"
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "dns_proxy",
        "type": "https",
        "server": "1.1.1.1",
        "detour": "🌐Proxy"
      },
      {
        "tag": "dns_direct",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "dns_fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "query_type": [
              "HTTPS",
              "SVCB"
            ]
          },
          {
            "rule_set": [
              "geosite-category-ads-all"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "dns_fakeip",
        "rewrite_ttl": 1
      },
      {
        "clash_mode": "Global",
        "server": "dns_proxy"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "clash_mode": "Direct"
          },
          {
            "rule_set": "geosite-cn"
          }
        ],
        "server": "dns_direct"
      }
    ],
    "strategy": "ipv4_only",
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 2334
    }
  ],
  "outbounds": [
    {
      "tag": "🎯Direct",
      "type": "direct"
    },
    {
      "tag": "🌐Proxy",
      "type": "selector",
      "outbounds": [
        "⚡UrlTest"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "💬AI",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": true
    },
    {
      "tag": "🚀LowLatency",
      "type": "selector",
      "outbounds": [],
      "interrupt_exist_connections": true
    },
    {
      "tag": "⚡UrlTest",
      "type": "urltest",
      "outbounds": [],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 40,
      "interrupt_exist_connections": true
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns_direct",
      "strategy": "ipv4_only"
    },
    "final": "🌐Proxy",
    "rules": [
      {
        "action": "sniff",
        "timeout": "200ms"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "strategy": "prefer_ipv4",
        "action": "resolve"
      },
      {
        "source_ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "network": "udp",
            "port": 443
          }
        ],
        "action": "reject"
      },
      {
        "protocol": [
          "bittorrent",
          "ssh",
          "stun"
        ],
        "outbound": "🎯Direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "🌐Proxy"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "clash_mode": "Direct"
          },
          {
            "ip_is_private": true
          }
        ],
        "outbound": "🎯Direct"
      },
      {
        "ip_cidr": [
          "103.149.93.9/32"
        ],
        "outbound": "🎯Direct"
      },
      {
        "rule_set": [
          "geosite-category-ai-!cn",
          "geosite-jetbrains-ai",
          "claude"
        ],
        "outbound": "💬AI"
      },
      {
        "domain_suffix": [
          "release-assets.githubusercontent.com",
          "gstatic.com",
          "googlevideo.com"
        ],
        "outbound": "🌐Proxy"
      },
      {
        "rule_set": [
          "hdy-domain",
          "hdy-port",
          "hdy-pname"
        ],
        "outbound": "🎯Direct"
      },
      {
        "rule_set": [
          "geoip-cn",
          "geosite-cn"
        ],
        "outbound": "🎯Direct"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "clash_mode": "Rule",
        "action": "reject"
      },
      {
        "rule_set": [
          "geoip-telegram",
          "geosite-telegram"
        ],
        "outbound": "🌐Proxy"
      },
      {
        "rule_set": "geosite-bilibili",
        "outbound": "🎯Direct"
      },
      {
        "rule_set": [
          "geoip-netflix",
          "geosite-netflix"
        ],
        "outbound": "🌐Proxy"
      },
      {
        "rule_set": "geosite-disney",
        "outbound": "🌐Proxy"
      },
      {
        "rule_set": [
          "geosite-youtube",
          "geosite-hbo",
          "geosite-primevideo"
        ],
        "outbound": "🌐Proxy"
      },
      {
        "rule_set": [
          "geoip-google",
          "geosite-google"
        ],
        "outbound": "💬AI"
      },
      {
        "rule_set": [
          "geosite-github"
        ],
        "outbound": "🚀LowLatency"
      },
      {
        "rule_set": [
          "geoip-apple",
          "geosite-apple",
          "geosite-amazon"
        ],
        "outbound": "🎯Direct"
      },
      {
        "rule_set": "geosite-microsoft",
        "outbound": "🎯Direct"
      },
      {
        "rule_set": [
          "geosite-steam",
          "geosite-category-games",
          "geosite-dmm",
          "game-download"
        ],
        "outbound": "🎯Direct"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "🌐Proxy"
      }
    ],
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
